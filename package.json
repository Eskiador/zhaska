{
  "name": "zhaska",
  "productName": "ZHASKA",
  "version": "0.1.0",
  "description": "IDE de programación con agente de IA local (Ollama)",
  "author": "ZHASKA",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eskiador/zhaska.git"
  },
  "homepage": "https://github.com/Eskiador/zhaska",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "electron-vite build && electron scripts/smoke.cjs",
    "test:restore": "electron-vite build && node scripts/restore-e2e.cjs",
    "test:package": "electron-vite build && electron-builder --dir --publish never && node scripts/package-e2e.mjs",
    "test:update": "node scripts/update-e2e.mjs",
    "test:perf": "electron-vite build && node scripts/dist.cjs --dir && node scripts/perf-e2e.mjs",
    "dist": "electron-vite build && node scripts/dist.cjs",
    "dist:win": "electron-vite build && node scripts/ensure-win-deps.cjs && node scripts/dist.cjs --win --x64",
    "icons": "node scripts/make-icons.cjs",
    "eval:agent": "vitest run --config vitest.eval.config.mts",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "electron-updater": "^6.8.11",
    "mammoth": "^1.13.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.5.438",
    "read-excel-file": "^9.3.20",
    "tesseract.js": "^7.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.77.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron": true,
    "fsevents": false,
    "node-pty": true,
    "tesseract.js": false,
    "electron-winstaller": false
  }
}
